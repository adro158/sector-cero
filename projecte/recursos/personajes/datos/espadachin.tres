[resource]
script = ExtResource("1_personaje")
nombre = "Espadachín"
descripcion = "Firewall: golpea todo lo que tiene alrededor cada 0,6 s. Es el mejor cuando te rodea la horda, sobre todo bits corruptos. No llega lejos: hay que dejar que se acerquen. Roba vida: cada golpe le cura un 10 % del daño que hace (hasta 3 de vida). Evoluciona a Firewall perimetral con Heurística agresiva ×3."
