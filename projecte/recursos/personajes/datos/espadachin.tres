[resource]
script = ExtResource("1_personaje")
nombre = "Espadachín"
descripcion = "Firewall: cada 0,6 s da un tajo en cono hacia donde vas, que hace más daño cuanto más pegado está el malware (el triple de cerca que en el filo). Es el mejor cuando te rodea la horda, sobre todo bits corruptos: encáralos, que lo de detrás no lo toca. Roba vida: cada golpe le cura un 10 % del daño que hace (hasta 1,5 de vida). Evoluciona a Firewall perimetral con Heurística agresiva ×3: llega más lejos, pega igual cerca que lejos y roba más."
hoja = ExtResource("2_hoja")
hoja_evolucion = ExtResource("5_hoja_evolucion")
hoja_ataque = ExtResource("6_ataque")
hoja_ataque_evolucion = ExtResource("7_ataque_evolucion")
segundos_ataque = 0.05
arma = ExtResource("3_arma")
vida_maxima = 120.0
ulti = "giro"
nombre_ulti = "Torbellino"
descripcion_ulti = "Gira con sus hojas de luz durante un segundo y medio y destroza todo lo que tiene alrededor."
color = Color(0.4, 1, 0.5, 1)
retrato = ExtResource("4_retrato")
