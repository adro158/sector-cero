[resource]
script = ExtResource("1_personaje")
nombre = "Segador"
descripcion = "Escáner: un pulso amplio y fuerte, pero lento (cada 2,5 s). El mejor contra grupos grandes y enemigos duros como el proceso colgado. Entre pulso y pulso estás desprotegido. Evoluciona a Análisis heurístico con Ampliar subred ×3."
hoja = ExtResource("2_hoja")
hoja_evolucion = ExtResource("5_hoja_evolucion")
hoja_ataque = ExtResource("6_ataque")
hoja_ataque_evolucion = ExtResource("7_ataque_evolucion")
hoja_correr_ataque = ExtResource("8_correr_ataque")
hoja_correr_ataque_evolucion = ExtResource("9_correr_ataque_evolucion")
segundos_ataque = 0.06
arma = ExtResource("3_arma")
vida_maxima = 100.0
ulti = "tormenta"
nombre_ulti = "Tormenta"
descripcion_ulti = "Un rayo cae sobre su guadaña y estalla alrededor; después caen mini rayos por toda la zona."
color = Color(1, 0.35, 0.35, 1)
retrato = ExtResource("4_retrato")
