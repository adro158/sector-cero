[resource]
script = ExtResource("1_personaje")
nombre = "Mago"
descripcion = "Ping: dispara un paquete que salta de un enemigo a otro, hasta cinco. El mejor contra enemigos sueltos o rápidos (paquetes perdidos) y para pegar al jefe y a los élites sin acercarse. Evoluciona a Ping de inundación con Multihilo ×3."
hoja = ExtResource("2_hoja")
hoja_evolucion = ExtResource("5_hoja_evolucion")
hoja_ataque = ExtResource("6_ataque")
hoja_ataque_evolucion = ExtResource("7_ataque_evolucion")
segundos_ataque = 0.05
arma = ExtResource("3_arma")
vida_maxima = 90.0
ulti = "rayo"
nombre_ulti = "Rayo de datos"
descripcion_ulti = "Un rayo morado enorme que atraviesa todo lo que encuentra. Con el teclado, R para apuntar con el ratón y click para lanzarlo (click derecho o R cancelan); con el mando, va solo al enemigo más cercano."
color = Color(0.75, 0.45, 1, 1)
retrato = ExtResource("4_retrato")
